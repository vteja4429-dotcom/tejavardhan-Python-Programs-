   ],
   "source": [
    "\n",
    "text = \"python\"\n",
    "\n",
    "frequency = {}\n",
    "\n",
    "for char in text:\n",
    "    if char in frequency:\n",
    "        frequency[char] += 1\n",
    "    else:\n",
    "        frequency[char] = 1\n",
    "\n",
    "print(\"Character frequency:\")\n",
    "\n",
    "for char, count in frequency.items():\n",
    "    print(char, \":\", count)\n"
   ]
  }
